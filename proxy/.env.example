# Copy to proxy/.env and fill. Never committed.
#
# Pinned by digest, not tag — see the note at the top of docker-compose.yml.
LITELLM_IMAGE=ghcr.io/berriai/litellm@sha256:REPLACE_ME

LITELLM_MASTER_KEY=sk-REPLACE_ME
LITELLM_SALT_KEY=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# oMLX's own key. Read from ~/.omlx/settings.json auth.api_key.
OMLX_API_KEY=REPLACE_ME

# Root CA of a TLS-inspecting corporate proxy, PEM (C7). Leave unset if you
# are not behind one; the mount then points at /dev/null.
CORP_ROOT_CA=
