# Copy to .env.local (untracked) and adjust. Read by proxy/launchd/install.sh
# and bench/doctor.py. Proxy secrets live separately in proxy/.env.

# LaunchAgent label prefix: labels are $LAUNCHD_PREFIX.llm-queue etc.
LAUNCHD_PREFIX=local
# Where the LaunchAgents write their logs and the queue's event log.
LLM_LOG_DIR=$HOME/Library/Logs/llm_queue
# opencode config that bench/verify_wiring.py checks (environment only; it
# does not read this file, so export it if the default is wrong).
OPENCODE_CONFIG=$HOME/.config/opencode/opencode.json
